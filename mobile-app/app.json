{
  "expo": {
    "name": "mobile-app",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture a selfie during clock in.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to record where clock in and clock out happened."
      }
    },
    "android": {
      "package": "com.hris.attendance",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cc9c7442-69de-4f6b-b282-b0143862554a"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to access the camera to capture a clock-in selfie."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow this app to access your location while you clock in or clock out."
        }
      ]
    ]
  }
}
